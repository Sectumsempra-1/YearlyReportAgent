# Model endpoint (OpenAI-compatible). Ollama for the PoC, vLLM later.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=not-needed
# How much a reasoning model thinks before answering: none, low, medium, high.
# low is the default; leave it empty for servers or models that do not support it.
LLM_REASONING_EFFORT=low
# Optional. Unset: the model's own sampling settings (recommended for reasoning
# models; a temperature of 0 can make them repeat themselves endlessly).
# LLM_TEMPERATURE=
# Longest reply in tokens, reasoning included (default 8000).
# LLM_MAX_TOKENS=8000
# Requests sent to the server at the same time (default 1: Ollama on one GPU
# works on one at a time). Raise it for a server that batches, like vLLM.
# LLM_MAX_PARALLEL=1

# SQLite database written by ingest.py and read by report_tools.py
REPORT_DB=data/report.db

# Rule 7: no external services at runtime. LangSmith is installed as a
# langchain dependency; keep its tracing off.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Evaluation only (scripts/compare_models.py, eval/score.py)
# EVAL_MODELS=qwen3.5:9b,qwen3:8b
# EVAL_JUDGE_MODEL=qwen3.5:9b
